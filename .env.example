# ── DagsHub / DVC ─────────────────────────────────────────────────────────────
# Clés d'accès DagsHub pour le push/pull DVC (S3 DagsHub)
DAGSHUB_ACCESS_KEY=your_dagshub_access_key_here
DAGSHUB_SECRET_KEY=your_dagshub_secret_key_here

# ── Airflow ────────────────────────────────────────────────────────────────────
# UID de l'utilisateur hôte (obligatoire sous Linux pour éviter les problèmes de permissions)
# Lancer : echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# Identifiants du compte admin Airflow (créé automatiquement par airflow-init)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ── Backend FastAPI ────────────────────────────────────────────────────────────
# Secret partagé entre Airflow et le backend pour l'endpoint /internal/reload-model
# Doit être identique dans .env et dans airflow/dags/retrain_dag.py (INTERNAL_SECRET)
INTERNAL_SECRET=airflow-internal-secret
